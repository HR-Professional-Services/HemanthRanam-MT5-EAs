# ==============================================================================
# MetaTrader 5 (MQL5) Git Ignore Rules
# ==============================================================================

# Compiled Executables & Binaries (Strict Exclusion)
*.ex5
*.ex4
*.dll
*.so
*.dylib

# Configuration, Presets & Profiles
*.ini
*.tpl
# Allow curated Strategy Tester presets
!Tests_And_Reports/Presets/*.set

# Logs, Cache & History
*.log
*.tmp
*.dat
*.bin
*.tst
logs/*
!logs/CHANGELOG_INTERNAL.md
cache/
profiles/

# MetaTrader Strategy Tester Reports & Artifacts
Tester/
reports/
*.htm
*.html

# IDE & Editor Artifacts
.idea/
.vscode/
*.swp
*~

# Operating System Artifacts
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# Research Lab Local Data & Ticks (Strictly kept in C:\MT5_Research_Lab\)
Research_Lab/
*.csv

